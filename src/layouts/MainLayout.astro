---
import BaseHead from "./BaseHead.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

const {
	title = "Amy Morrison",
	description = "Finally learning to communicate in my native tongue.",
} = Astro.props;
---

<html lang="en">
	<BaseHead {title} {description} />
	<body>
		<Header />
		<main>
			<slot />
		</main>
	</body>
</html>
